{
  "info": {
    "name": "Auth Lab 05 Tests",
    "description": "Tests for Authentication and Authorization - Lab 05. Covers registration, login, token validation, and role-based access control.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Register Admin User",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 201 or 409\", function () {",
              "    pm.expect(pm.response.code).to.be.oneOf([201, 409]);",
              "});",
              "pm.test(\"Response has user data without password\", function () {",
              "    var jsonData = pm.response.json();",
              "    if (pm.response.code === 201) {",
              "        pm.expect(jsonData.user).to.have.property('name');",
              "        pm.expect(jsonData.user).to.have.property('email');",
              "        pm.expect(jsonData.user).to.not.have.property('password');",
              "    }",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Admin Faheem\",\n  \"email\": \"faheem.admin@example.com\",\n  \"password\": \"securepassword\",\n  \"role\": \"admin\"\n}"
        },
        "url": {
          "raw": "http://localhost:3000/api/auth/register",
          "protocol": "http",
          "host": ["localhost"],
          "port": "3000",
          "path": ["api", "auth", "register"]
        }
      }
    },
    {
      "name": "2. Register Regular User",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 201 or 409\", function () {",
              "    pm.expect(pm.response.code).to.be.oneOf([201, 409]);",
              "});",
              "pm.test(\"User role defaults to 'user'\", function () {",
              "    var jsonData = pm.response.json();",
              "    if (pm.response.code === 201) {",
              "        pm.expect(jsonData.user.role).to.eql('user');",
              "    }",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Regular User\",\n  \"email\": \"regular.user@example.com\",\n  \"password\": \"userpassword123\"\n}"
        },
        "url": {
          "raw": "http://localhost:3000/api/auth/register",
          "protocol": "http",
          "host": ["localhost"],
          "port": "3000",
          "path": ["api", "auth", "register"]
        }
      }
    },
    {
