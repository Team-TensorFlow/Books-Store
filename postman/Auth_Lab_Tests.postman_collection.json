    {
      "name": "8. Admin Creates Book (Valid Token + Admin Role)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 201 - Admin can create book\", function () {",
              "    pm.expect(pm.response.code).to.not.be.oneOf([401, 403]);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{adminToken}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Test Book\",\n  \"author\": \"Test Author\",\n  \"price\": 10,\n  \"genre\": \"Test\",\n  \"published_year\": 2024\n}"
        },
        "url": {
          "raw": "http://localhost:3000/api/books",
          "protocol": "http",
          "host": ["localhost"],
          "port": "3000",
          "path": ["api", "books"]
        }
      }
    },
