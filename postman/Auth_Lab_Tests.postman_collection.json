          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 403 Forbidden - Regular user cannot create book\", function () {",
              "    pm.response.to.have.status(403);",
              "});",
              "pm.test(\"Returns permission denied error\", function () {",
              "    var jsonData = pm.response.json();",
