    {
      "name": "5. Login Admin User",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test(\"Response has JWT token\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.token).to.exist;",
              "    pm.collectionVariables.set(\"adminToken\", jsonData.token);",
              "});",
              "pm.test(\"Response has user info without password\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.user.role).to.eql('admin');",
              "    pm.expect(jsonData.user).to.not.have.property('password');",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"faheem.admin@example.com\",\n  \"password\": \"securepassword\"\n}"
        },
        "url": {
          "raw": "http://localhost:3000/api/auth/login",
          "protocol": "http",
          "host": ["localhost"],
          "port": "3000",
          "path": ["api", "auth", "login"]
        }
      }
    },
