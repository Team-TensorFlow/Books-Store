{
  "info": {
    "name": "Books Store API Tests",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Check Express Web Server",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "http://localhost:3000",
          "protocol": "http",
          "host": [
            "localhost"
          ],
          "port": "3000"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 200', function () { pm.response.to.have.status(200); });",
              "pm.test('Response returns HTML page', function () { pm.expect(pm.response.text()).to.include('html'); });"
            ]
          }
        }
      ]
    }
  ]
}
